# LeadG environment variables
#
# Copy to .env and fill in values. Per-user integration settings stored in
# the UI (Settings → Integrations) override these for individual users.

# --- LLM (voice conversation, sentiment, email drafting, date extraction) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Vapi voice AI (outbound/inbound calls, warm transfers) ---
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_PUBLIC_KEY=

# --- Twilio (SMS / WhatsApp fallback messages) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email dispatch ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Direct mail ---
LOB_API_KEY=

# --- App ---
DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_SECRET=
NEXTAUTH_URL=
PORT=3001
NODE_ENV=production
